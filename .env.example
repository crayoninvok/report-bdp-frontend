# Backend API Base URL
# For production on Vercel, set this to your deployed backend URL:
# Example: https://report-bdp-backend.vercel.app/api
# Or: https://report-bdp-backend.vercel.app
NEXT_PUBLIC_API_URL=https://your-backend-app.vercel.app/api

# Google Gemini AI API Key (Optional)
# Digunakan untuk analisis otomatis grafik Cost Report & Presentasi Eksekutif (Gemini AI Analysis)
# Jika dikosongkan, sistem secara cerdas menggunakan Algorithmic Smart AI Engine lokal bawaan.
GEMINI_API_KEY=

